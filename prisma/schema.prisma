generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model users {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  nivelDeCliente String
  password       String
  role           Role
  userId         String @unique
}

enum Role {
  ADMIN
  CLIENTE
  OPERADOR
  USUARIO
}