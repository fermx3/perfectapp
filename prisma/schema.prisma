generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Zonas {
  norte
  iztapalapa
  merced
  test
}

type UserInfo {
  nombre         String
  nivelDeCliente String?
  cadena         String?
  frecuencia     String[]
  leales         String?
  asesorAsignado String[]
  central        String?
  ubicacion      String?
  canal          String?
  coordinador    String?
  asesores       String[]
  zona           Zonas?
  zonaAsignada   Zonas[]
}

type CuotaPallets {
  iberia90g  String?
  iberia225g String?
  iberia1Kg  String?
}

type ValorDePuntos {
  iberia90g  String?
  iberia225g String?
  iberia1Kg  String?
}

type PlanPromocional {
  promocionales String?
  materialesPop String?
  planDemo      String?
  recompensas   String?
}

type DatosLeal {
  nombreDelEncargado String?
  email              String?
  telefono           String?
  fechaDeAniversario String?
  puntosLeal         Int?
}

model users {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  password        String
  role            Role
  userId          String           @unique
  userInfo        UserInfo
  cuotaPallets    CuotaPallets?
  valorDePuntos   ValorDePuntos?
  planPromocional PlanPromocional?
  datosLeal       DatosLeal?
}

enum Role {
  ADMIN
  LEAL
  ASESOR
  COORDINADOR
  USUARIO
}

type Competidores {
  nombre    String
  productos Productos[]
}

type Productos {
  gramos               String
  precio               Int
  hasPromo             Boolean
  pop                  Boolean?
  precioConPromo       Int?
  precioConPromoReason String?
}

type Promociones {
  implementada Boolean
  promo        String
}

type OrdenDeCompra {
  cajas     Int
  objetivo  Int?
  producto  String
  promocion Boolean?
  puntos    Int?
}

type PlanDeComunicacion {
  alcance    Boolean
  materiales String
}

type Materiales {
  material String
  pop      Boolean
}

type Exhibiciones {
  periodoNegociado String
  pop              Boolean
  producto         String
}

model visitas {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  asesor              String
  inicioVisita        String
  finVisita           String
  numeroDeCliente     String
  competidores        Competidores[]
  comentarios1        String
  promociones         Promociones[]
  cuentaConInventario Boolean
  hayOrdenDeCompra    Boolean
  porqueNoCompra      String?
  distribuidor        String?
  comentarios2        String
  ordenDeCompra       OrdenDeCompra[]
  planDeComunicacion  PlanDeComunicacion[]
  materiales          Materiales[]
  exhibiciones        Exhibiciones[]
  comentarios3        String
}

type PromocionesDelMes {
  promo          String
  nivelDeCliente String[]
}

model config {
  id                       String              @id @default(auto()) @map("_id") @db.ObjectId
  empresa                  String              @unique
  distribuidores           String[]
  competidores             String[]
  gramajes                 String[]
  opcionesDeNoCompra       String[]
  promocionesDelMes        PromocionesDelMes[]
  sku                      String[]
  materialesDeComunicacion String[]
}
