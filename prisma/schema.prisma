generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type UserInfo {
  nivelDeCliente   String?
  nombre           String
}

model users {
  id       String        @id @default(auto()) @map("_id") @db.ObjectId
  password String
  role     Role
  userId   String @unique
  userInfo UserInfo
}

enum Role {
  ADMIN
  LEAL
  ASESOR
  CLIENTE
}

model clientes {
    id              String        @id @default(auto()) @map("_id") @db.ObjectId
    nombre          String
    cadena          Boolean
    leales          String
    nivelDeCliente  String
    userId          String @unique
}