generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Zonas {
  norte
  iztapalapa
  merced
  test
}

type UserInfo {
  nombre         String
  nivelDeCliente String?
  cadena         String?
  frecuencia     String[]
  leales         String?
  asesorAsignado String[]
  central        String?
  ubicacion      String?
  canal          String?
  coordinador    String?
  asesores       String[]
  grupo          String?
  zona           Zonas?
  zonaAsignada   Zonas[]
}

type CuotaPallets {
  iberia90g  String?
  iberia225g String?
  iberia1Kg  String?
}

type ValorDePuntos {
  iberia90g  String?
  iberia225g String?
  iberia1Kg  String?
}

type PlanPromocional {
  promocionales String?
  materialesPop String?
  planDemo      String?
  recompensas   String?
}

type DatosLeal {
  nombreDelEncargado String?
  email              String?
  telefono           String?
  fechaDeAniversario String?
  puntosLeal         Int?
  firstLoginDate     String?
}

type Orden {
  iberia90g  Int
  iberia225g Int
  iberia1Kg  Int
}

type Ventas {
  fecha String
  orden Orden
}

model users {
  id              String           @id @default(cuid()) @map("_id")
  password        String
  role            Role
  userId          String           @unique
  userInfo        UserInfo
  cuotaPallets    CuotaPallets?
  valorDePuntos   ValorDePuntos?
  planPromocional PlanPromocional?
  datosLeal       DatosLeal?
  ventas          Ventas[]
}

enum Role {
  ADMIN
  LEAL
  ASESOR
  COORDINADOR
  USUARIO
}

type Competidores {
  nombre    String
  productos Productos[]
}

type Productos {
  gramos               String
  precio               Int
  hasPromo             Boolean
  pop                  Boolean?
  precioConPromo       Int?
  precioConPromoReason String?
}

type Promociones {
  implementada Boolean
  promo        String
  sku          String
}

type OrdenDeCompra {
  cajas        Int
  objetivo     Int?
  producto     String
  sku          String?
  promocion    Boolean?
  puntos       Int?
  promo        String
  cajasXpallet Int?
}

type Inventario {
  cajas        Int
  producto     String
  sku          String
  cajasXpallet Int?
}

type PlanDeComunicacion {
  alcance    Boolean
  materiales String
}

type Materiales {
  material String
  pop      Boolean
}

type Exhibiciones {
  periodoNegociado String
  pop              Boolean
  producto         String
}

model visitas {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  asesor              String
  inicioVisita        String
  finVisita           String
  numeroDeCliente     String
  competidores        Competidores[]
  comentarios1        String
  promociones         Promociones[]
  cuentaConInventario Boolean
  inventario          Inventario[]
  hayOrdenDeCompra    Boolean
  porqueNoCompra      String?
  distribuidor        String?
  comentarios2        String
  ordenDeCompra       OrdenDeCompra[]
  planDeComunicacion  PlanDeComunicacion[]
  materiales          Materiales[]
  exhibiciones        Exhibiciones[]
  comentarios3        String
}

type PromocionesDelMes {
  promo          String
  nivelDeCliente String[]
  sku            String
}

type Skus {
  sku          String
  producto     String
  cajasXpallet Int?
}

model config {
  id                       String              @id @default(auto()) @map("_id") @db.ObjectId
  empresa                  String              @unique
  distribuidores           String[]
  competidores             String[]
  gramajes                 String[]
  opcionesDeNoCompra       String[]
  promocionesDelMes        PromocionesDelMes[]
  skus                     Skus[]
  materialesDeComunicacion String[]
  avisoDePrivacidad        String
  terminosYCondiciones     String
}

model prospectos {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  nombre         String
  canal          String
  central        String
  ubicacion      String
  grupo          String?
  nivelDeCliente String
  comentarios    String?
}

model mensajesAsesores {
  id        String @id @map("_id")
  titulo    String
  contenido String
}

model ordenes {
  id            String          @id @map("_id")
  asesor        String
  cliente       String
  fecha         String
  distribuidor  String
  orden         OrdenDeCompra[]
  ordenValidada Boolean
}
